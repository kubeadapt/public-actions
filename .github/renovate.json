{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Istanbul",
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "gitIgnoredAuthors": ["ugurcancaykara@users.noreply.github.com"],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Automerge minor and patch updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Require manual approval for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update", "dependencies"]
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "labels": ["github-actions", "dependencies"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Pin GitHub Actions to commit SHA for security",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ],
  "labels": ["renovate", "dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "assignees": ["ugurcancaykara"]
  }
}
